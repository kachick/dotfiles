{
  "$schema": "https://dprint.dev/schemas/v0.json",

  // These options may has difference values than https://github.com/microsoft/TypeScript/blob/v7.0.2/.dprint.jsonc#L7-L31.
  // But we don't need to follow upstream decision https://github.com/microsoft/TypeScript/issues/5811#issuecomment-160187924.
  "typescript": {
    "quoteStyle": "preferSingle",
    "useBraces": "always"
  },
  "json": {
    "trailingCommas": "never"
  },
  "toml": {
  },
  "dockerfile": {
    "associations": [
      // It doesn't officially support Containerfile, but I didn't have trouble for these files.
      "Containerfile"
    ]
  },
  "ruff": {
  },
  "markup": {
  },
  "yaml": {
    "quotes": "preferSingle",
    "trimTrailingWhitespaces": false // https://github.com/g-plane/pretty_yaml/issues/1
  },
  "shuck": {
    "useTabs": true
  },
  "kdl": {
    "kdlVersion": "v1"
  },
  // Don't specify go version and module path for global use
  "gofumpt": {
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.28.0",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/dockerfile@0.7.0",
    "npm:@dprint/ruff@0.11.2",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/nix@0.1.2",
    "npm:@dprint/shuck@0.2.2",
    "npm:@dprint/typstyle@0.5.3",
    "npm:@dprint/kdl@0.4.3",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.20"
  ]
}
