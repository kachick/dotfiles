{
  "$schema": "https://dprint.dev/schemas/v0.json",

  // These options may has difference values than https://github.com/microsoft/TypeScript/blob/v7.0.2/.dprint.jsonc#L7-L31.
  // But we don't need to follow upstream decision https://github.com/microsoft/TypeScript/issues/5811#issuecomment-160187924.
  "typescript": {
    "quoteStyle": "preferSingle",
    "useBraces": "always"
  },
  "json": {
    "trailingCommas": "never"
  },
  "markdown": {
    "tags": {
      "nix": "nix",
      "sh": "sh",
      "bash": "bash",
      "zsh": "zsh",
      "envrc": "bash",
      "shell": "sh",
      "shell-script": "sh"
    }
  },
  "toml": {
  },
  "dockerfile": {
    "associations": [
      // It doesn't officially support Containerfile, but I didn't have trouble for these files.
      "Containerfile"
    ]
  },
  "ruff": {
  },
  "markup": {
  },
  "yaml": {
    "quotes": "preferSingle",
    "trimTrailingWhitespaces": false // https://github.com/g-plane/pretty_yaml/issues/1
  },
  "sh": {
    "useTabs": true
  },
  "kdl": {
    "kdlVersion": "v1"
  },
  // Don't specify go version and module path for global use
  "gofumpt": {
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.1",
    "npm:@dprint/markdown@0.25.0",
    "npm:@dprint/toml@0.8.0",
    "npm:@dprint/dockerfile@0.6.0",
    "npm:@dprint/ruff@0.9.1",
    "npm:dprint-plugin-markup@0.27.5",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@kachick/dprint-plugin-nix@0.1.1",
    "npm:@kachick/dprint-plugin-sh@0.1.2",
    "npm:@kachick/dprint-plugin-typstyle@0.5.1",
    "npm:@kachick/dprint-plugin-kdl@0.4.2",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.18"
  ]
}
