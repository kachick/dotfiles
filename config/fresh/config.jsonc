{
  "$schema": "https://raw.githubusercontent.com/sinelaw/fresh/main/crates/fresh-editor/plugins/config-schema.json",
  "check_for_updates": false, // Not only for updates, need to disable for telemetry. The blocker for Zero config: https://github.com/sinelaw/fresh/issues/2520
  "self_update": false,
  "theme": "builtin://terminal",
  // Fresh has no global default formatter, so repeat the dprint config per language.
  "languages": {
    "bash": {
      "formatter": {
        "command": "dprint",
        "args": ["fmt", "--stdin", "$FILE"],
        "stdin": true
      },
      "format_on_save": true
    },
    "dockerfile": {
      "formatter": {
        "command": "dprint",
        "args": ["fmt", "--stdin", "$FILE"],
        "stdin": true
      },
      "format_on_save": true
    },
    "go": {
      "formatter": {
        "command": "dprint",
        "args": ["fmt", "--stdin", "$FILE"],
        "stdin": true
      },
      "format_on_save": true
    },
    "html": {
      "formatter": {
        "command": "dprint",
        "args": ["fmt", "--stdin", "$FILE"],
        "stdin": true
      },
      "format_on_save": true
    },
    "javascript": {
