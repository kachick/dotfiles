{
  "editor.defaultFormatter": "dprint.dprint",
  "editor.formatOnSave": true,
  "[kanata]": {
    "editor.defaultFormatter": "rszyma.vscode-kanata"
  },
  "[github-actions-workflow]": {
    // vscode itself or something often sets this to redhat.vscode-yaml by default
    // it seems annoy and hard to debug. So ensure to use dprint with this config
    // See also https://github.com/kachick/times_kachick/issues/257
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[yaml]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[nix]": {
    // "dprint.dprint" is often ignored for Nix, so explicitly set dprint formatting in the Nix extension.
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  },
  "nix.serverPath": "nixd",
  "nix.enableLanguageServer": true,
  // To prefer dprint over nixfmt, we should override LS settings here.
  // Because nix.formatterPath does not work if we use `enableLanguageServer`
  "nix.serverSettings": {
    "nil": {
      "formatting": {
        "command": ["dprint", "fmt", "--stdin", "nix"]
      }
    },
    "nixd": {
      "formatting": {
        "command": ["dprint", "fmt", "--stdin", "nix"]
      }
    }
  },
  // Fallback or just a note for no LS
  "nix.formatterPath": ["dprint", "fmt", "--stdin", "nix"],
  "gopls": {
    // Use dprint once https://github.com/golang/go/issues/74678 is resolved
    "formatting.gofumpt": true,
    "build.buildFlags": ["-tags=linux,windows,darwin"]
  },
  "shellcheck.ignorePatterns": {
    "dependencies/**": true,
    "config/ghostty/config*": true
  },
  "search.exclude": {
    ".direnv/**": true,
    "dependencies/*sh/": true
  },
  "rumdl.configPath": ".rumdl.toml",
  "rumdl.server.path": "rumdl"
}
