{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "json": {
    "trailingCommas": "never"
  },
  "markdown": {
    "tags": {
      "nix": "nix",
      "sh": "sh",
      "bash": "bash",
      "zsh": "zsh",
      "envrc": "bash",
      "shell": "sh",
      "shell-script": "sh"
    }
  },
  "yaml": {
    "quotes": "preferSingle",
    "trimTrailingWhitespaces": false
  },
  "toml": {
    "quoteStyle": "maintain"
  },
  "sh": {
    "useTabs": true
  },
  "dockerfile": {
    "associations": [
      "Containerfile"
    ]
  },
  "kdl": {
    "kdlVersion": "v1"
  },
  "gofumpt": {
    "langVersion": "go1.27",
    "modulePath": "github.com/kachick/dotfiles"
  },
  "excludes": [
    "dependencies"
  ],
  "plugins": [
    "npm:@dprint/json@0.24.0",
    "npm:@dprint/markdown@0.24.0",
    "npm:@dprint/toml@0.8.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@kachick/dprint-plugin-kdl@0.4.1",
    "npm:@dprint/dockerfile@0.6.0",
    "npm:@kachick/dprint-plugin-nix@0.1.1",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.18",
    "npm:@kachick/dprint-plugin-sh@0.1.1"
  ]
}
