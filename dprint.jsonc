{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "json": {
    "trailingCommas": "never"
  },
  "markdown": {
    "tags": {
      "nix": "nix",
      "sh": "sh",
      "bash": "bash",
      "zsh": "zsh",
      "envrc": "bash",
      "shell": "sh",
      "shell-script": "sh"
    }
  },
  "yaml": {
    "quotes": "preferSingle",
    "trimTrailingWhitespaces": false
  },
  "toml": {
    "quoteStyle": "maintain"
  },
  "sh": {
    "useTabs": true
  },
  "dockerfile": {
    "associations": [
      "Containerfile"
    ]
  },
  "kdl": {
    "kdlVersion": "v1"
  },
  "gofumpt": {
    "langVersion": "go1.27",
    "modulePath": "github.com/kachick/dotfiles"
  },
  "excludes": [
    "dependencies"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.24.0.wasm",
    "https://plugins.dprint.dev/markdown-0.24.0.wasm",
    "https://plugins.dprint.dev/toml-0.8.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/kachick/kdl-0.4.0.wasm",
    "https://plugins.dprint.dev/dockerfile-0.6.0.wasm",
    "https://plugins.dprint.dev/kachick/nix-0.1.0.wasm",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.18",
    "https://plugins.dprint.dev/kachick/sh-0.1.0.wasm"
  ]
}
