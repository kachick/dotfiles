{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>kachick/renovate-config//presets/default.jsonc",
    "github>kachick/renovate-config//presets/gomod.jsonc"
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Keep channel-tracking flake inputs fixed to current release series",
      "matchManagers": [
        "nix"
      ],
      "matchPackageNames": [
        "nixpkgs",
        "home-manager",
        "nixos-wsl"
      ],
      "enabled": false
    }
  ]
}
