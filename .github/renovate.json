{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    "github>kachick/renovate-config-dprint#1.4.0"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "enabledManagers": [
    "custom.regex",
    "dockerfile"
  ],
  "packageRules": [
    {
      "extends": [
        "schedule:weekly"
      ],
      "matchPackageNames": [
        "dprint{/,}**"
      ]
    }
  ]
}
