# https://github.com/kachick/containers
# You can get the digest by using:
# skopeo inspect docker://ghcr.io/kachick/ubuntu-26.04-nix-systemd:latest | jq -r '.Digest'
FROM ghcr.io/kachick/ubuntu-26.04-nix-systemd:latest@sha256:8297d9b421eaa96d22334818e6b6a24ba0173011b55974ac1d49b9b6ca46bc6e

LABEL org.opencontainers.image.source=https://github.com/kachick/dotfiles
LABEL org.opencontainers.image.description="Example by kachick/dotfiles"
LABEL org.opencontainers.image.licenses=MIT

USER user
# Docker/Podman doesn't set $USER in the USER instruction, which results in home-manager activation failure
# https://stackoverflow.com/questions/54411218/docker-why-isnt-user-environment-variable-set
ENV USER=user
ENV PATH="/home/user/.nix-profile/bin:${PATH}"

RUN mkdir -p ~/.local/state/nix/profiles

# Don't use /tmp, it removes in first run
COPY ./ /provisioner/dotfiles/
COPY ./containers/needs_systemd.bash /provisioner/needs_systemd.bash

# Ensure runtime directory for the user is created on boot and XDG_RUNTIME_DIR is set in login shells
USER root
RUN user_uid="$(id -u user)" \
	&& mkdir -p /etc/tmpfiles.d \
	&& echo "d /run/user/${user_uid} 0700 user user -" > /etc/tmpfiles.d/user-runtime-dir.conf \
	&& echo 'if [ -z "${XDG_RUNTIME_DIR-}" ]; then export XDG_RUNTIME_DIR="/run/user/$(id -u)"; fi' > /etc/profile.d/xdg-runtime-dir.sh

CMD ["/usr/lib/systemd/systemd", "--system"]
