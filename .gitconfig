[core]
  whitespace = cr-at-eol

# Rely on the editor's format-on-save for daily workflow.
# Run `task lint` (which verifies formatting via `treefmt --fail-on-change` in cmd/lint)
# instead of running `task fmt` here, avoiding duplicate formatter runs and unstaged diffs.
# If this fails, do not just run `task fmt` to work around it. Always investigate and fix
# the root cause of why format-on-save did not run in your editor.
[hook "lint"]
  event = "pre-commit"
  command = "task lint"
